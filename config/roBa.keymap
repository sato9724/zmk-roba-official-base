#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp LS(LEFT_ARROW)  &kp W        &kp LS(RIGHT_ARROW)  &kp R            &kp T                               &none  &none  &none  &none  &none
&kp LEFT_ARROW      &kp SPACE    &kp RIGHT_ARROW      &kp F            &kp BACKSPACE  &none         &none  &none  &none  &none  &none  &none
&kp LC(MINUS)       &mt X SPACE  &kp LC(LS(MINUS))    &mt LG(V) LC(V)  &kp B          &kp RETURN    &none  &none  &none  &none  &none  &none
&kp RC(Z)           &kp LC(C)    &kp LC(V)            &mo 1            &kp SPACE      &mo 3         &none  &none                       &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        layer_1 {
            bindings = <
&trans                    &kp LS(BACKSPACE)         &trans                     &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&kp LC(LS(LEFT_BRACKET))  &kp LC(NON_US_BACKSLASH)  &kp LS(LC(RIGHT_BRACKET))  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&kp LC(LS(LEFT_BRACKET))  &kp BACKSPACE             &kp LC(LS(RIGHT_BRACKET))  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans                    &trans                    &trans                     &mo 1   &trans  &trans    &trans  &trans                          &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;
        };
    };
};
